{
  "compilerOptions": {
    "esModuleInterop": true,
    "declaration": true,
    "importHelpers": true,
    "module": "CommonJS",
    "paths": {
      "chalk": ["./node_modules/chalk/source/index.d.ts"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "es2019",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["tools/**/*"]
}
